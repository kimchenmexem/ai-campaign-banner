# ─────────────────────────────────────────────────────────────
# AI Campaign Banner Generator — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# This file is the public template — keep it free of real secrets.
# ─────────────────────────────────────────────────────────────

# ── AI provider abstraction ────────────────────────────────
# Choose one: "openai" or "anthropic"
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Image generator. Default model = gpt-image-1, default quality = "high"
# (the practical v2-equivalent tier — sharper photographic detail at ~4×
# the medium-tier cost: $0.17 vs $0.04 for 1024×1024).
# When OpenAI ships gpt-image-2, set OPENAI_IMAGE_MODEL=gpt-image-2 here.
# Quality options: high | medium | low (gpt-image-1) or hd | standard (dall-e-3).
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=high
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by Route Handlers / Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix used when uploading campaign assets
CLOUDINARY_BASE_FOLDER=ai-campaign-banner

# ── Bannerbear ─────────────────────────────────────────────
BANNERBEAR_API_KEY=
# Optional: project-scoped key if using a master account
BANNERBEAR_PROJECT_ID=
# Template UIDs for each ad size. Create one template per size in Bannerbear
# and paste the UID here. The app maps a requested size → template UID.
BANNERBEAR_TEMPLATE_1200x628=
BANNERBEAR_TEMPLATE_1080x1080=
BANNERBEAR_TEMPLATE_1080x1920=

# ── App ────────────────────────────────────────────────────
# Public base URL (used for callbacks, signed downloads, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── marketing-translator (campaign copy source) ────────────
# marketing-translator is the SINGLE source of headline / subheadline /
# cta / disclaimer for every campaign. ai-campaign-banner does not invent
# copy locally — the planner calls /api/campaign-copy and writes the
# response into each concept's copy_package before manifest construction.
#
# When MARKETING_TRANSLATOR_API_URL is unset, the planner falls back to a
# deterministic local mock so dev work doesn't depend on the translator
# running. Production must set both vars.
#
# MARKETING_TRANSLATOR_API_KEY must match CAMPAIGN_COPY_API_KEY on the
# translator side. Generate with:  openssl rand -hex 32
MARKETING_TRANSLATOR_API_URL=
MARKETING_TRANSLATOR_API_KEY=
